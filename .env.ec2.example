APP_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=*

# Keep SQLite and local uploads on Docker volumes for the first single-instance EC2 deploy.
DATABASE_URL=/app/data/coaching.db
UPLOAD_DIR=/app/uploads

# Optional S3 storage for uploaded media. Recommended before real users upload large files.
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=your-media-bucket
# AWS_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://your-cloudfront-domain.example
